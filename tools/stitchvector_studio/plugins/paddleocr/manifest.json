{"plugin_id": "stitchvector.ocr.paddleocr", "version": "1.0.0", "api_version": 1, "stage": "ocr",
 "entrypoint": "tools.stitchvector_studio.plugins.paddleocr.plugin:Plugin",
 "input_schemas": ["raster_document.v1"], "output_schemas": ["ocr_candidates.v1"],
 "capabilities": ["text_detection", "text_recognition_zh_en", "geological_generic_rules"],
 "runtime": {"type": "python_subprocess", "python": "runs/ocr_poc01/venvs/paddle/bin/python", "timeout_s": 1800,
             "model_cache": "runs/ocr_poc01/cache/paddle"},
 "parameters": {"min_score": {"type": "number", "default": 0.0, "min": 0, "max": 1},
                "geological_generic_rules": {"type": "boolean", "default": true},
                "deduplicate": {"type": "boolean", "default": true}},
 "code_files": ["tools/stitchvector_studio/plugins/paddleocr/plugin.py", "tools/stitchvector_studio/geo_rules.py"],
